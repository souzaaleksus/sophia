@model ClienteDto
@{
    ViewData["Title"] = "Excluir cliente";
    var pagina = new PaginaDeExclusao(
        Model.Id,
        "Excluir cliente?",
        "A exclusão não pode ser desfeita. Clientes com vendas não podem ser excluídos.",
        Model.Nome,
        "CPF",
        Model.Cpf);
}

<partial name="_PaginaDeExclusao" model="pagina" />
