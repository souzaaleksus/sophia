@model ClienteDto
@{
    ViewData["Title"] = T["clientes.excluir-pagina"].Value;
    var pagina = new PaginaDeExclusao(
        Model.Id,
        T["clientes.excluir-titulo"],
        T["clientes.excluir-aviso"],
        Model.Nome,
        T["campo.cpf"],
        Model.Cpf);
}

<partial name="_PaginaDeExclusao" model="pagina" />
