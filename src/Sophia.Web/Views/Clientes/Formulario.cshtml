@model ClienteFormulario
@{
    ViewData["Title"] = Model.EhNovo ? T["clientes.novo"].Value : T["clientes.editar"].Value;
    var acao = Model.EhNovo ? "Novo" : "Editar";
}

<div class="cabecalho-da-pagina">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="subtitulo">@T["clientes.subtitulo"]</p>
    </div>
</div>

<form class="cartao formulario" method="post" asp-action="@acao" asp-route-id="@Model.Id" novalidate
      data-envio data-texto-enviando="@T["formulario.salvando"]">
    <div asp-validation-summary="ModelOnly" class="aviso aviso-falha" role="alert"></div>
    <p class="legenda-obrigatorio"><span aria-hidden="true">*</span> @T["formulario.obrigatorio"]</p>

    <div class="grade-de-campos">
        <div class="campo">
            <label asp-for="Cpf" class="form-label">@T["campo.cpf"] <span class="obrigatorio" aria-hidden="true">*</span></label>
            <input asp-for="Cpf" class="form-control" inputmode="numeric" autocomplete="off" autofocus
                   aria-required="true" placeholder="000.000.000-00" data-mascara="cpf" data-val-cpf="@T["validacao.cpf-invalido"]" />
            <span asp-validation-for="Cpf" class="erro"></span>
        </div>

        <div class="campo campo-largo">
            <label asp-for="Nome" class="form-label">@T["campo.nome"] <span class="obrigatorio" aria-hidden="true">*</span></label>
            <input asp-for="Nome" class="form-control" autocomplete="off" aria-required="true" />
            <span class="campo-dica">@T["clientes.dica-nome"]</span>
            <span asp-validation-for="Nome" class="erro"></span>
        </div>

        <div class="campo">
            <label asp-for="DataNascimento" class="form-label"></label>
            <input asp-for="DataNascimento" type="text" class="form-control" inputmode="numeric" autocomplete="bday"
                   placeholder="dd/mm/aaaa" data-mascara="data" />
            <span asp-validation-for="DataNascimento" class="erro"></span>
        </div>

        <div class="campo">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" placeholder="nome@exemplo.com.br" />
            <span asp-validation-for="Email" class="erro"></span>
        </div>

        <div class="campo">
            <label asp-for="Telefone" class="form-label"></label>
            <input asp-for="Telefone" type="tel" class="form-control" inputmode="tel"
                   placeholder="(11) 98765-4321" data-mascara="telefone"
                   data-val="true" data-val-telefone="@T["validacao.telefone-sem-ddd"]" />
            <span asp-validation-for="Telefone" class="erro"></span>
        </div>
    </div>

    <div class="rodape-do-formulario">
        <a class="btn btn-outline-secondary" asp-action="Index">@T["formulario.cancelar"]</a>
        <button type="submit" class="btn btn-primary">@T["formulario.salvar"]</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
