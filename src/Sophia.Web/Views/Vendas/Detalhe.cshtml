@model VendaDetalheDto
@{
    ViewData["Title"] = T["venda.titulo", Model.Id].Value;
    var recemRegistrada = TempData.Peek(Avisos.ChaveDeSucesso) is not null;
    var unidades = Model.Itens.Sum(item => item.Quantidade);
}

<div class="cabecalho-da-pagina">
    <div>
        <h1>@T["venda.titulo", Model.Id]</h1>
        <p class="subtitulo">@T["venda.registrada-em", Formato.Data(Model.Data)]</p>
    </div>
    <div class="nao-imprimir">
        <button type="button" class="btn btn-outline-secondary" data-acao="imprimir">
            <svg class="icone" aria-hidden="true"><use href="#icone-imprimir" /></svg>
            @T["venda.imprimir"]
        </button>
    </div>
</div>

<section class="cupom@(recemRegistrada ? " cupom-recem-emitido" : string.Empty)" aria-label="@T["venda.comprovante"]">
    <header class="cupom-topo">
        <img class="cupom-logo" src="~/img/sophia.png" alt="@T["geral.marca"]" width="117" height="32" />
        <dl class="cupom-identificacao">
            <div>
                <dt>@T["venda.venda"]</dt>
                <dd class="numero">@T["venda.numero", Model.Id]</dd>
            </div>
            <div>
                <dt>@T["campo.data"]</dt>
                <dd class="numero">@Formato.Data(Model.Data)</dd>
            </div>
        </dl>
    </header>

    <div class="cliente-da-venda" data-testid="cliente-da-venda">
        <span class="rotulo">@T["campo.cliente"]</span>
        <strong>@Model.ClienteNome</strong>
        <span class="numero">@T["clientes.detalhe-cpf", Model.ClienteCpf]</span>
    </div>

    <table class="cupom-itens">
        <caption class="visually-hidden">@T["venda.produtos-da-venda"]</caption>
        <thead>
            <tr>
                <th scope="col">@T["campo.produto"]</th>
                <th scope="col" class="valor coluna-opcional">@T["campo.quantidade"]</th>
                <th scope="col" class="valor coluna-opcional">@T["campo.valor-unitario"]</th>
                <th scope="col" class="valor">@T["campo.subtotal"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td>
                        <span class="destaque">@item.Produto</span>
                        <span class="cupom-conta numero apenas-no-celular">@T["venda.conta", item.Quantidade, Formato.Moeda(item.ValorUnitario)]</span>
                    </td>
                    <td class="valor coluna-opcional">@item.Quantidade</td>
                    <td class="valor coluna-opcional">@Formato.Moeda(item.ValorUnitario)</td>
                    <td class="valor">@Formato.Moeda(item.Subtotal)</td>
                </tr>
            }
        </tbody>
    </table>

    <footer class="cupom-rodape">
        <p class="cupom-resumo numero">
            @T["venda.resumo", Formato.Quantidade(Model.Itens.Count, T["venda.itens-singular"], T["venda.itens-plural"]), Formato.Quantidade(unidades, T["vendas.unidades-singular"], T["vendas.unidades-plural"])]
        </p>
        <p class="cupom-total">
            <span>@T["venda.total"]</span>
            <strong class="numero" data-testid="total-da-venda">@Formato.Moeda(Model.Total)</strong>
        </p>
    </footer>
</section>

<p class="nao-imprimir voltar"><a asp-action="Index">@T["venda.voltar"]</a></p>
