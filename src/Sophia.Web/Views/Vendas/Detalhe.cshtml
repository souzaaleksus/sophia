@model VendaDetalheDto
@{
    ViewData["Title"] = $"Venda nº {Model.Id}";
}

<div class="cabecalho-da-pagina">
    <div>
        <h1>Venda nº @Model.Id</h1>
        <p class="subtitulo">Registrada em @Formato.Data(Model.Data).</p>
    </div>
    <div class="nao-imprimir">
        <button type="button" class="btn btn-outline-secondary" data-acao="imprimir">
            <svg class="icone" aria-hidden="true"><use href="#icone-imprimir" /></svg>
            Imprimir
        </button>
        <a class="btn btn-primary" asp-action="Nova">
            <svg class="icone" aria-hidden="true"><use href="#icone-mais" /></svg>
            Nova venda
        </a>
    </div>
</div>

<section class="cartao comprovante" aria-label="Comprovante da venda">
    <div class="cliente-da-venda" data-testid="cliente-da-venda">
        <span class="rotulo">Cliente</span>
        <strong>@Model.ClienteNome</strong>
        <span class="numero">CPF @Model.ClienteCpf</span>
    </div>

    <div class="tabela-rolavel">
        <table class="tabela">
            <thead>
                <tr>
                    <th scope="col">Produto</th>
                    <th scope="col" class="valor">Quantidade</th>
                    <th scope="col" class="valor">Valor unitário</th>
                    <th scope="col" class="valor">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Itens)
                {
                    <tr>
                        <td class="destaque">@item.Produto</td>
                        <td class="valor">@item.Quantidade</td>
                        <td class="valor">@Formato.Moeda(item.ValorUnitario)</td>
                        <td class="valor">@Formato.Moeda(item.Subtotal)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th scope="row" colspan="3" class="valor">Total da venda</th>
                    <td class="valor total" data-testid="total-da-venda">@Formato.Moeda(Model.Total)</td>
                </tr>
            </tfoot>
        </table>
    </div>
</section>

<p class="nao-imprimir voltar"><a asp-action="Index">Voltar para as vendas</a></p>
