@model Sophia.Application.Pagina<VendaResumoDto>
@inject Sophia.Application.Abstracoes.IRelogio Relogio
@inject Sophia.Application.ParametrosDoSophia Parametros
@{
    ViewData["Title"] = "Vendas";
    var ordem = ViewData["Ordem"] as string ?? "-data";
    var de = ViewData["De"] as DateOnly?;
    var ate = ViewData["Ate"] as DateOnly?;
    var filtros = FiltrosDaLista.De(ViewData);
    var hoje = Relogio.Hoje;
    var comPeriodo = de is not null || ate is not null;
    var diasDoAtalho = Parametros.DiasDoAtalhoDePeriodo;
    var atalhos = new[]
    {
        (Rotulo: "Hoje", De: hoje, Ate: hoje),
        (Rotulo: $"{diasDoAtalho} dias", De: hoje.AddDays(1 - diasDoAtalho), Ate: hoje),
        (Rotulo: "Mês", De: new DateOnly(hoje.Year, hoje.Month, 1), Ate: hoje),
    };
    var colunaData = new ColunaOrdenavel("Data", "data", ordem, filtros, "coluna-opcional");
    var colunaTotal = new ColunaOrdenavel("Total", "total", ordem, filtros, "valor");
}

<div class="cabecalho-da-pagina">
    <div>
        <h1>Vendas</h1>
        <p class="subtitulo">Tudo o que a loja vendeu, com filtro por período.</p>
    </div>
</div>

<form class="periodo" method="get" asp-action="Index" aria-label="Período das vendas">
    <div class="periodo-campos">
        <div class="campo">
            <label class="form-label" for="periodo-de">De</label>
            <input class="form-control" type="date" id="periodo-de" name="de" value="@FiltrosDaLista.DataDaConsulta(de)" max="@FiltrosDaLista.DataDaConsulta(hoje)" />
        </div>
        <div class="campo">
            <label class="form-label" for="periodo-ate">Até</label>
            <input class="form-control" type="date" id="periodo-ate" name="ate" value="@FiltrosDaLista.DataDaConsulta(ate)" max="@FiltrosDaLista.DataDaConsulta(hoje)" />
        </div>
        <input type="hidden" name="ordem" value="@ordem" />
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
    </div>
    <nav class="periodo-atalhos" aria-label="Atalhos de período">
        @foreach (var atalho in atalhos)
        {
            var ativo = de == atalho.De && ate == atalho.Ate;
            <a class="atalho-de-periodo@(ativo ? " ativo" : string.Empty)" aria-current="@(ativo ? "true" : null)"
               asp-route-de="@FiltrosDaLista.DataDaConsulta(atalho.De)" asp-route-ate="@FiltrosDaLista.DataDaConsulta(atalho.Ate)" asp-route-ordem="@ordem">@atalho.Rotulo</a>
        }
        @if (comPeriodo)
        {
            <a class="atalho-de-periodo" asp-route-ordem="@ordem">Todas</a>
        }
    </nav>
</form>

@if (Model.TotalDeItens == 0 && comPeriodo)
{
    <div class="vazio">
        <svg class="ilustracao" aria-hidden="true"><use href="#ilustracao-busca" /></svg>
        <p class="vazio-titulo">Nenhuma venda neste período.</p>
        <p>Escolha outras datas ou veja todas as vendas.</p>
        <a class="btn btn-outline-secondary" asp-action="Index">Ver todas as vendas</a>
    </div>
}
else if (Model.TotalDeItens == 0)
{
    <partial name="_SemVendas" model="false" />
}
else
{
    <p class="contagem" data-testid="contagem">@Formato.Quantidade(Model.TotalDeItens, "venda", "vendas")</p>

    <div class="cartao tabela-rolavel">
        <table class="tabela">
            <thead>
                <tr>
                    <th scope="col" class="coluna-opcional">Nº</th>
                    <partial name="_ColunaOrdenavel" model="colunaData" />
                    <th scope="col">Cliente</th>
                    <th scope="col" class="valor coluna-opcional">Itens</th>
                    <partial name="_ColunaOrdenavel" model="colunaTotal" />
                    <th scope="col"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var venda in Model.Itens)
                {
                    <tr>
                        <td class="numero coluna-opcional">@venda.Id</td>
                        <td class="numero coluna-opcional">@Formato.Data(venda.Data)</td>
                        <td>
                            <div class="destaque">@venda.ClienteNome</div>
                            <div class="secundario numero">@venda.ClienteCpf</div>
                            <div class="secundario numero apenas-no-celular">nº @venda.Id, @Formato.Data(venda.Data)</div>
                        </td>
                        <td class="valor coluna-opcional">@venda.QuantidadeDeItens</td>
                        <td class="valor destaque">@Formato.QuebrarNoMilhar(Formato.Moeda(venda.Total))</td>
                        <td class="acoes">
                            <a class="acao" asp-action="Detalhe" asp-route-id="@venda.Id" aria-label="Ver a venda @venda.Id">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Paginador" model="Paginador.De(Model, filtros)" />
}
