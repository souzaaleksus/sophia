@model IReadOnlyList<VendaResumoDto>
@{
    ViewData["Title"] = "Vendas";
}

<div class="cabecalho-da-pagina">
    <div>
        <h1>Vendas</h1>
        <p class="subtitulo">As mais recentes primeiro.</p>
    </div>
    <a class="btn btn-primary btn-lg" asp-action="Nova">
        <svg class="icone" aria-hidden="true"><use href="#icone-mais" /></svg>
        Nova venda
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="vazio">
        <span class="vazio-icone"><svg class="icone" aria-hidden="true"><use href="#icone-carrinho" /></svg></span>
        <p class="vazio-titulo">Nenhuma venda registrada ainda.</p>
        <p>Escolha o cliente, lance os produtos e a primeira venda aparece aqui.</p>
        <a class="btn btn-primary" asp-action="Nova">
            <svg class="icone" aria-hidden="true"><use href="#icone-mais" /></svg>
            Registrar a primeira venda
        </a>
    </div>
}
else
{
    <div class="cartao tabela-rolavel">
        <table class="tabela">
            <thead>
                <tr>
                    <th scope="col" class="coluna-opcional">Nº</th>
                    <th scope="col" class="coluna-opcional">Data</th>
                    <th scope="col">Cliente</th>
                    <th scope="col" class="valor coluna-opcional">Itens</th>
                    <th scope="col" class="valor">Total</th>
                    <th scope="col"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var venda in Model)
                {
                    <tr>
                        <td class="numero coluna-opcional">@venda.Id</td>
                        <td class="numero coluna-opcional">@Formato.Data(venda.Data)</td>
                        <td>
                            <div class="destaque">@venda.ClienteNome</div>
                            <div class="secundario numero">@venda.ClienteCpf</div>
                            <div class="secundario numero apenas-no-celular">@Formato.Data(venda.Data)</div>
                        </td>
                        <td class="valor coluna-opcional">@venda.QuantidadeDeItens</td>
                        <td class="valor destaque">@Formato.Moeda(venda.Total)</td>
                        <td class="acoes">
                            <a class="acao" asp-action="Detalhe" asp-route-id="@venda.Id" aria-label="Ver a venda @venda.Id">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
