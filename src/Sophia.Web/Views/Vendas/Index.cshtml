@model Sophia.Application.Pagina<VendaResumoDto>
@inject Sophia.Application.Abstracoes.IRelogio Relogio
@inject Sophia.Application.ParametrosDoSophia Parametros
@{
    ViewData["Title"] = T["menu.vendas"].Value;
    var ordem = ViewData["Ordem"] as string ?? "-data";
    var de = ViewData["De"] as DateOnly?;
    var ate = ViewData["Ate"] as DateOnly?;
    var filtros = FiltrosDaLista.De(ViewData);
    var hoje = Relogio.Hoje;
    var comPeriodo = de is not null || ate is not null;
    var diasDoAtalho = Parametros.DiasDoAtalhoDePeriodo;
    var atalhos = new[]
    {
        (Rotulo: T["vendas.atalho-hoje"].Value, De: hoje, Ate: hoje),
        (Rotulo: T["vendas.atalho-dias", diasDoAtalho].Value, De: hoje.AddDays(1 - diasDoAtalho), Ate: hoje),
        (Rotulo: T["vendas.atalho-mes"].Value, De: new DateOnly(hoje.Year, hoje.Month, 1), Ate: hoje),
    };
    var colunaData = new ColunaOrdenavel(T["campo.data"], "data", ordem, filtros, "coluna-opcional");
    var colunaTotal = new ColunaOrdenavel(T["campo.total"], "total", ordem, filtros, "valor");
}

<div class="cabecalho-da-pagina">
    <div>
        <h1>@T["menu.vendas"]</h1>
        <p class="subtitulo">@T["vendas.subtitulo"]</p>
    </div>
</div>

<form class="periodo" method="get" asp-action="Index" aria-label="@T["vendas.periodo"]">
    <div class="periodo-campos">
        <div class="campo">
            <label class="form-label" for="periodo-de">@T["vendas.de"]</label>
            <input class="form-control" type="date" id="periodo-de" name="de" value="@FiltrosDaLista.DataDaConsulta(de)" max="@FiltrosDaLista.DataDaConsulta(hoje)" />
        </div>
        <div class="campo">
            <label class="form-label" for="periodo-ate">@T["vendas.ate"]</label>
            <input class="form-control" type="date" id="periodo-ate" name="ate" value="@FiltrosDaLista.DataDaConsulta(ate)" max="@FiltrosDaLista.DataDaConsulta(hoje)" />
        </div>
        <input type="hidden" name="ordem" value="@ordem" />
        <button type="submit" class="btn btn-outline-secondary">@T["vendas.filtrar"]</button>
    </div>
    <nav class="periodo-atalhos" aria-label="@T["vendas.atalhos"]">
        @foreach (var atalho in atalhos)
        {
            var ativo = de == atalho.De && ate == atalho.Ate;
            <a class="atalho-de-periodo@(ativo ? " ativo" : string.Empty)" aria-current="@(ativo ? "true" : null)"
               asp-route-de="@FiltrosDaLista.DataDaConsulta(atalho.De)" asp-route-ate="@FiltrosDaLista.DataDaConsulta(atalho.Ate)" asp-route-ordem="@ordem">@atalho.Rotulo</a>
        }
        @if (comPeriodo)
        {
            <a class="atalho-de-periodo" asp-route-ordem="@ordem">@T["vendas.todas"]</a>
        }
    </nav>
</form>

@if (Model.TotalDeItens == 0 && comPeriodo)
{
    <div class="vazio">
        <svg class="ilustracao" aria-hidden="true"><use href="#ilustracao-busca" /></svg>
        <p class="vazio-titulo">@T["vendas.nenhuma-no-periodo"]</p>
        <p>@T["vendas.outro-periodo"]</p>
        <a class="btn btn-outline-secondary" asp-action="Index">@T["vendas.ver-todas"]</a>
    </div>
}
else if (Model.TotalDeItens == 0)
{
    <div class="vazio">
        <svg class="ilustracao" aria-hidden="true"><use href="#ilustracao-vendas" /></svg>
        <p class="vazio-titulo">@T["vendas.nenhuma"]</p>
        <p>@T["vendas.vazio-convite"]</p>
        <a class="btn btn-primary" asp-action="Nova">
            <svg class="icone" aria-hidden="true"><use href="#icone-mais" /></svg>
            @T["vendas.registrar-primeira"]
        </a>
    </div>
}
else
{
    <p class="contagem" data-testid="contagem">@Formato.Quantidade(Model.TotalDeItens, T["vendas.contagem-singular"], T["vendas.contagem-plural"])</p>

    <div class="cartao tabela-rolavel">
        <table class="tabela">
            <thead>
                <tr>
                    <th scope="col" class="coluna-opcional">@T["vendas.numero"]</th>
                    <partial name="_ColunaOrdenavel" model="colunaData" />
                    <th scope="col">@T["campo.cliente"]</th>
                    <th scope="col" class="valor coluna-opcional">@T["campo.itens"]</th>
                    <partial name="_ColunaOrdenavel" model="colunaTotal" />
                    <th scope="col"><span class="visually-hidden">@T["lista.acoes"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var venda in Model.Itens)
                {
                    <tr>
                        <td class="numero coluna-opcional">@venda.Id</td>
                        <td class="numero coluna-opcional">@Formato.Data(venda.Data)</td>
                        <td>
                            <div class="destaque">@venda.ClienteNome</div>
                            <div class="secundario numero">@venda.ClienteCpf</div>
                            <div class="secundario numero apenas-no-celular">@Formato.Data(venda.Data)</div>
                        </td>
                        <td class="valor coluna-opcional">@venda.QuantidadeDeItens</td>
                        <td class="valor destaque">@Formato.Moeda(venda.Total)</td>
                        <td class="acoes">
                            <a class="acao" asp-action="Detalhe" asp-route-id="@venda.Id" aria-label="@T["acao.ver-venda", venda.Id]">@T["acao.ver"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Paginador" model="Paginador.De(Model, filtros)" />
}
