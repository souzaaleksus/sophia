@model NovaVendaFormulario
@{
    ViewData["Title"] = T["vendas.nova-venda"].Value;
    var hoje = (DateOnly)ViewData["Hoje"]!;
    var clienteEscolhido = Model.ClienteId is not null;
    var erroDosItens = ViewData.ModelState.PrimeiroErro("Itens");
    var itensLancados = Model.Itens.Where(item => item.ProdutoId is not null).ToList();
    var totalDaVenda = Model.Itens.Sum(item => (item.Quantidade ?? 0) * (item.ValorUnitario ?? 0));

    void LinhaDoItem(int indice, ItemDaVendaFormulario item, bool comErros)
    {
        string? ErroDe(string campo) => comErros ? ViewData.ModelState.PrimeiroErro($"Itens[{indice}].{campo}") : null;
        string Valor(string campo, string formatado) => comErros ? ValorTentado.Ou(ViewData.ModelState, $"Itens[{indice}].{campo}", formatado) : formatado;

        <div class="caixa-item" data-testid="item-da-venda" data-item>
            <div class="campo caixa-produto">
                <label class="form-label caixa-rotulo" for="item-@indice-ProdutoNome">@T["campo.produto"]</label>
                <div class="autocompletar">
                    <input id="item-@indice-ProdutoNome" name="Itens[@indice].ProdutoNome" value="@item.ProdutoNome"
                           type="text" class="form-control" role="combobox" aria-autocomplete="list"
                           aria-expanded="false" aria-controls="item-@indice-opcoes" autocomplete="off"
                           placeholder="@T["caixa.busque-pelo-nome"]" data-campo="ProdutoNome" />
                    <ul id="item-@indice-opcoes" class="opcoes" role="listbox" aria-label="@T["caixa.produtos-encontrados"]" hidden></ul>
                </div>
                <input type="hidden" name="Itens[@indice].ProdutoId" value="@item.ProdutoId" data-campo="ProdutoId" />
                <span class="erro" data-erro="ProdutoId" data-valmsg-for="Itens[@indice].ProdutoId">@ErroDe("ProdutoId")</span>
            </div>
            <div class="campo caixa-valor">
                <label class="form-label caixa-rotulo" for="item-@indice-ValorUnitario">@T["campo.valor-unitario"]</label>
                <div class="input-group">
                    <span class="input-group-text">@T["geral.moeda"]</span>
                    <input id="item-@indice-ValorUnitario" name="Itens[@indice].ValorUnitario" value="@Valor("ValorUnitario", Formato.Numero(item.ValorUnitario))"
                           type="text" class="form-control valor" inputmode="decimal" autocomplete="off"
                           placeholder="@T["caixa.valor-vazio"]" data-campo="ValorUnitario" />
                </div>
                <span class="erro" data-erro="ValorUnitario" data-valmsg-for="Itens[@indice].ValorUnitario">@ErroDe("ValorUnitario")</span>
            </div>
            <div class="campo caixa-quantidade">
                <label class="form-label caixa-rotulo" for="item-@indice-Quantidade">@T["campo.quantidade"]</label>
                <div class="quantidade-com-botoes">
                    <button type="button" class="botao-quantidade" data-acao="menos" aria-label="@T["caixa.diminuir"]">&minus;</button>
                    <input id="item-@indice-Quantidade" name="Itens[@indice].Quantidade" value="@Valor("Quantidade", Formato.Inteiro(item.Quantidade))"
                           type="number" min="1" max="@int.MaxValue" step="1" class="form-control valor" inputmode="numeric"
                           data-campo="Quantidade" />
                    <button type="button" class="botao-quantidade" data-acao="mais" aria-label="@T["caixa.aumentar"]">+</button>
                </div>
                <span class="erro" data-erro="Quantidade" data-valmsg-for="Itens[@indice].Quantidade">@ErroDe("Quantidade")</span>
            </div>
            <div class="campo caixa-subtotal">
                <span class="caixa-rotulo">@T["campo.subtotal"]</span>
                <output data-testid="subtotal" data-campo="Subtotal">@Formato.Moeda((item.Quantidade ?? 0) * (item.ValorUnitario ?? 0))</output>
            </div>
            <button type="button" class="caixa-remover" data-acao="remover-item" aria-label="@T["caixa.remover"]" title="@T["caixa.remover"]">
                <svg class="icone" aria-hidden="true"><use href="#icone-excluir" /></svg>
            </button>
        </div>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/caixa.css" asp-append-version="true" />
}

<div class="cabecalho-da-pagina">
    <div>
        <h1>@T["vendas.nova-venda"]</h1>
        <p class="subtitulo">@T["caixa.subtitulo"]</p>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="aviso aviso-falha" role="alert"></div>
@if (ViewData.ModelState.PrimeiroErro(nameof(NovaVendaFormulario.Chave)) is { } formularioJaUsado)
{
    <div class="aviso aviso-falha" role="alert">@formularioJaUsado</div>
}

<form method="post" asp-action="Nova" id="nova-venda" class="caixa" novalidate aria-busy="true"
      data-endereco-busca-de-clientes="@Url.Action("Buscar", "Clientes")"
      data-endereco-busca-de-produtos="@Url.Action("Buscar", "Produtos")"
      data-endereco-novo-cliente="@Url.Action("Novo", "Clientes")"
      data-envio
      data-texto-enviando="@T["caixa.registrando"]"
      data-texto-buscando="@T["caixa.buscando"]"
      data-texto-falha-na-busca="@T["caixa.falha-na-busca"]"
      data-texto-cliente-nao-encontrado="@T["clientes.nenhum"]"
      data-texto-cadastrar-cliente="@T["caixa.cadastrar-cliente"]"
      data-texto-produto-nao-encontrado="@T["produtos.nenhum"]"
      data-texto-produto-somado="@T["caixa.produto-somado"]"
      data-texto-item="@T["venda.itens-singular"]"
      data-texto-itens="@T["venda.itens-plural"]"
      data-texto-unidade="@T["vendas.unidades-singular"]"
      data-texto-unidades="@T["vendas.unidades-plural"]">

    <section class="cartao caixa-cliente" aria-labelledby="titulo-cliente">
        <div class="caixa-cabecalho-do-cartao">
            <h2 id="titulo-cliente">@T["campo.cliente"]</h2>
            <kbd class="atalho" title="@T["caixa.atalho-de-teclado"]">F2</kbd>
        </div>

        <input type="hidden" name="Chave" value="@Model.Chave" autocomplete="off" />
        <input type="hidden" asp-for="ClienteId" data-cliente="id" />
        <input type="hidden" asp-for="ClienteNome" data-cliente="nome" />
        <input type="hidden" asp-for="ClienteCpf" data-cliente="cpf" />

        <div class="caixa-busca-de-cliente" data-cliente="busca" hidden="@clienteEscolhido">
            <label for="busca-cliente" class="visually-hidden">@T["campo.cliente"]</label>
            <div class="autocompletar">
                <input id="busca-cliente" type="text" class="form-control form-control-lg"
                       role="combobox" aria-autocomplete="list" aria-expanded="false"
                       aria-controls="busca-cliente-opcoes" aria-keyshortcuts="F2" autocomplete="off"
                       autofocus="@(!clienteEscolhido)"
                       placeholder="@T["caixa.digite-cpf-ou-nome"]" />
                <ul id="busca-cliente-opcoes" class="opcoes" role="listbox" aria-label="@T["caixa.clientes-encontrados"]" hidden></ul>
            </div>
        </div>

        <div class="caixa-cliente-escolhido" data-cliente="escolhido" data-testid="cliente-escolhido" hidden="@(!clienteEscolhido)">
            <div class="pessoa">
                <span class="avatar avatar-tom-@Formato.TomDoAvatar(Model.ClienteNome ?? string.Empty)" data-cliente="avatar" aria-hidden="true">@Formato.Iniciais(Model.ClienteNome ?? string.Empty)</span>
                <div>
                    <strong data-cliente="nome-exibido">@Model.ClienteNome</strong>
                    <span class="numero" data-cliente="cpf-exibido">@Model.ClienteCpf</span>
                </div>
            </div>
            <button type="button" class="btn btn-outline-secondary" data-cliente="trocar">@T["caixa.trocar-cliente"]</button>
        </div>
        <span asp-validation-for="ClienteId" class="erro"></span>

        <div class="campo caixa-data">
            <label asp-for="Data" class="form-label"></label>
            <input id="Data" name="Data" type="date" class="form-control"
                   value="@Formato.DataParaCampo(Model.Data)" max="@Formato.DataParaCampo(hoje)" />
            <span asp-validation-for="Data" class="erro"></span>
        </div>
    </section>

    <section class="cartao caixa-itens" aria-labelledby="titulo-itens">
        <div class="caixa-cabecalho-do-cartao">
            <h2 id="titulo-itens">@T["caixa.produtos"]</h2>
            <p class="dica caixa-dica-de-teclado">
                <kbd>@T["teclado.enter"]</kbd> @T["caixa.dica-enter"] <kbd>@T["teclado.esc"]</kbd> @T["caixa.dica-esc"]
            </p>
        </div>

        @if (erroDosItens is not null)
        {
            <div class="aviso aviso-falha" role="alert" data-valmsg-for="Itens">@erroDosItens</div>
        }

        <div class="caixa-cabecalho-dos-itens" aria-hidden="true">
            <span>@T["campo.produto"]</span>
            <span class="valor">@T["campo.valor-unitario"]</span>
            <span class="valor">@T["campo.quantidade"]</span>
            <span class="valor">@T["campo.subtotal"]</span>
        </div>

        <div class="caixa-lista-de-itens" data-itens>
            @for (var indice = 0; indice < Model.Itens.Count; indice++)
            {
                LinhaDoItem(indice, Model.Itens[indice], comErros: true);
            }
        </div>

        <p class="caixa-anuncio" data-anuncio role="status"></p>

        <div class="caixa-desfazer" data-desfazer role="status" hidden>
            <span>@T["caixa.produto-removido"]</span>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-acao="desfazer-remocao">@T["caixa.desfazer"]</button>
        </div>

        <div class="caixa-novo-item">
            <button type="button" class="btn btn-outline-primary" data-acao="adicionar-item" aria-keyshortcuts="F4">@T["caixa.adicionar-produto"]</button>
            <kbd class="atalho" title="@T["caixa.atalho-de-teclado"]">F4</kbd>
        </div>
    </section>

    <div class="caixa-fechamento">
        <section class="visor" aria-labelledby="titulo-do-visor">
            <h2 class="visor-rotulo" id="titulo-do-visor">@T["venda.total"]</h2>
            <output class="visor-valor" data-testid="total-da-venda" aria-live="polite"><span class="visor-moeda">@T["geral.moeda"]</span> <span data-visor="valor">@Formato.Numero(totalDaVenda)</span></output>
            <p class="visor-detalhe">
                <span data-testid="itens-da-venda">@Formato.Quantidade(itensLancados.Count, T["venda.itens-singular"], T["venda.itens-plural"])</span>
                <span data-testid="unidades-da-venda">@Formato.Quantidade(itensLancados.Sum(item => item.Quantidade ?? 0), T["vendas.unidades-singular"], T["vendas.unidades-plural"])</span>
            </p>
        </section>

        <button type="submit" class="btn btn-primary btn-lg w-100 caixa-finalizar" aria-keyshortcuts="Control+Enter">@T["caixa.finalizar"]</button>
        <p class="dica caixa-dica-de-teclado"><kbd>@T["teclado.ctrl"]</kbd> + <kbd>@T["teclado.enter"]</kbd> @T["caixa.dica-finalizar"]</p>
        <a class="btn btn-link w-100" asp-action="Index">@T["formulario.cancelar"]</a>
    </div>
</form>

<template id="modelo-de-item">
    @{ LinhaDoItem(0, new ItemDaVendaFormulario(), comErros: false); }
</template>

@section Scripts {
    <script type="module" src="~/js/nova-venda.js" asp-append-version="true"></script>
}
