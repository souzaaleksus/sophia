@model int
@using Microsoft.AspNetCore.Diagnostics
@{
    var naoEncontrado = Model == StatusCodes.Status404NotFound;
    var metodo = PaginaDeErro.MetodoOriginal(Context);
    var pedidoInvalido = Model == StatusCodes.Status400BadRequest;
    var consultaInvalida = pedidoInvalido && (HttpMethods.IsGet(metodo) || HttpMethods.IsHead(metodo));
    var envioInvalido = pedidoInvalido && !consultaInvalida;
    var caminho = Context.Features.Get<IStatusCodeReExecuteFeature>()?.OriginalPath
        ?? Context.Features.Get<IExceptionHandlerPathFeature>()?.Path
        ?? Context.Request.Path.Value;
    var area = AreaDoEndereco.De(caminho);
    var (destino, rotuloDoDestino) = area switch
    {
        AreaDoEndereco.Clientes => (AreaDoEndereco.Clientes, "Ir para os clientes"),
        AreaDoEndereco.Produtos => (AreaDoEndereco.Produtos, "Ir para os produtos"),
        AreaDoEndereco.Vendas => (AreaDoEndereco.Vendas, "Ir para as vendas"),
        _ => (AreaDoEndereco.Painel, "Ir para o painel"),
    };
    ViewData["Title"] = naoEncontrado ? "Página não encontrada" : "Algo deu errado";
}

<div class="vazio">
    <span class="vazio-icone"><svg class="icone" aria-hidden="true"><use href="#icone-alerta" /></svg></span>
    <h1>@ViewData["Title"]</h1>
    @if (naoEncontrado)
    {
        <p>O endereço não existe ou o registro foi excluído.</p>
    }
    else if (consultaInvalida && area == AreaDoEndereco.Painel)
    {
        <p>O endereço tem um valor que não foi entendido. Volte ao painel e tente de novo.</p>
    }
    else if (consultaInvalida)
    {
        <p>O endereço tem um valor que não foi entendido. Volte à lista e tente de novo.</p>
    }
    else if (envioInvalido)
    {
        <p>Não foi possível conferir o envio do formulário. Recarregue a página e tente de novo.</p>
    }
    else
    {
        <p>Não foi possível concluir a operação. Tente de novo em instantes.</p>
    }
    <a class="btn btn-primary" asp-controller="@destino" asp-action="Index">@rotuloDoDestino</a>
</div>
