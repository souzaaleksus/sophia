@model int
@{
    var naoEncontrado = Model == StatusCodes.Status404NotFound;
    ViewData["Title"] = naoEncontrado ? T["erro.nao-encontrada"].Value : T["erro.algo-deu-errado"].Value;
}

<div class="vazio">
    <span class="vazio-icone"><svg class="icone" aria-hidden="true"><use href="#icone-alerta" /></svg></span>
    <h1>@ViewData["Title"]</h1>
    @if (naoEncontrado)
    {
        <p>@T["erro.nao-existe"]</p>
    }
    else
    {
        <p>@T["erro.tente-de-novo"]</p>
    }
    <a class="btn btn-primary" asp-controller="Vendas" asp-action="Index">@T["erro.ir-para-as-vendas"]</a>
</div>
