@model ProdutoDto
@{
    ViewData["Title"] = "Excluir produto";
}

<div class="cabecalho-da-pagina">
    <div>
        <h1>Excluir produto?</h1>
        <p class="subtitulo">A exclusão não pode ser desfeita. Produtos já vendidos não podem ser excluídos.</p>
    </div>
</div>

<form class="cartao formulario" method="post" asp-action="Excluir" asp-route-id="@Model.Id">
    <dl class="resumo-de-registro">
        <dt>Nome</dt>
        <dd>@Model.Nome</dd>
        <dt>Valor unitário</dt>
        <dd>@Formato.Moeda(Model.ValorUnitario)</dd>
    </dl>

    <div class="rodape-do-formulario">
        <a class="btn btn-link" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-danger">Excluir</button>
    </div>
</form>
