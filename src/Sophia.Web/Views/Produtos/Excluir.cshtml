@model ProdutoDto
@{
    ViewData["Title"] = "Excluir produto";
    var pagina = new PaginaDeExclusao(
        Model.Id,
        "Excluir produto?",
        "A exclusão não pode ser desfeita. Produtos já vendidos não podem ser excluídos.",
        Model.Nome,
        "Valor unitário",
        Formato.Moeda(Model.ValorUnitario));
}

<partial name="_PaginaDeExclusao" model="pagina" />
