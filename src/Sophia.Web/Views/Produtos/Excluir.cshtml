@model ProdutoDto
@{
    ViewData["Title"] = T["produtos.excluir-pagina"].Value;
    var pagina = new PaginaDeExclusao(
        Model.Id,
        T["produtos.excluir-titulo"],
        T["produtos.excluir-aviso"],
        Model.Nome,
        T["campo.valor-unitario"],
        Formato.Moeda(Model.ValorUnitario));
}

<partial name="_PaginaDeExclusao" model="pagina" />
