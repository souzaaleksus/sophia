@model ProdutoFormulario
@{
    ViewData["Title"] = Model.EhNovo ? "Novo produto" : "Editar produto";
    var acao = Model.EhNovo ? "Novo" : "Editar";
}

<div class="cabecalho-da-pagina">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="subtitulo">O nome não pode se repetir. O valor é o sugerido na venda.</p>
    </div>
</div>

<form class="cartao formulario" method="post" asp-action="@acao" asp-route-id="@Model.Id" novalidate>
    <div asp-validation-summary="ModelOnly" class="aviso aviso-falha" role="alert"></div>

    <div class="grade-de-campos">
        <div class="campo campo-largo">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" autocomplete="off" />
            <span asp-validation-for="Nome" class="erro"></span>
        </div>

        <div class="campo">
            <label asp-for="ValorUnitario" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">R$</span>
                <input asp-for="ValorUnitario" type="text" class="form-control valor" inputmode="decimal"
                       autocomplete="off" placeholder="0,00" value="@Formato.Numero(Model.ValorUnitario)" />
            </div>
            <span asp-validation-for="ValorUnitario" class="erro"></span>
        </div>
    </div>

    <div class="rodape-do-formulario">
        <a class="btn btn-link" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primary">Salvar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
