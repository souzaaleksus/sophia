@model IReadOnlyList<ProdutoDto>
@{
    ViewData["Title"] = "Produtos";
    var busca = ViewData["Busca"] as string;
}

<div class="cabecalho-da-pagina">
    <div>
        <h1>Produtos</h1>
        <p class="subtitulo">O que a empresa comercializa.</p>
    </div>
    <a class="btn btn-primary" asp-action="Novo">Novo produto</a>
</div>

<form class="busca" method="get" asp-action="Index" role="search">
    <input type="search" name="busca" value="@busca" class="form-control"
           placeholder="Buscar pelo nome" aria-label="Buscar produtos pelo nome" />
    <button type="submit" class="btn btn-outline-secondary">Buscar</button>
</form>

@if (Model.Count == 0)
{
    <div class="vazio">
        <p>Nenhum produto encontrado.</p>
        @if (string.IsNullOrWhiteSpace(busca))
        {
            <a class="btn btn-primary" asp-action="Novo">Cadastrar o primeiro produto</a>
        }
    </div>
}
else
{
    <div class="cartao tabela-rolavel">
        <table class="tabela">
            <thead>
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col" class="valor">Valor unitário</th>
                    <th scope="col"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var produto in Model)
                {
                    <tr>
                        <td class="destaque">@produto.Nome</td>
                        <td class="valor">@Formato.Moeda(produto.ValorUnitario)</td>
                        <td class="acoes">
                            <a asp-action="Editar" asp-route-id="@produto.Id" aria-label="Editar @produto.Nome">Editar</a>
                            <a asp-action="Excluir" asp-route-id="@produto.Id" class="perigo" aria-label="Excluir @produto.Nome">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
