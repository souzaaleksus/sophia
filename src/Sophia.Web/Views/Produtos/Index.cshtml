@model IReadOnlyList<ProdutoDto>
@{
    ViewData["Title"] = "Produtos";
    var busca = ViewData["Busca"] as string;
}

<div class="cabecalho-da-pagina">
    <div>
        <h1>Produtos</h1>
        <p class="subtitulo">O que a loja vende e por quanto.</p>
    </div>
    <a class="btn btn-primary" asp-action="Novo">
        <svg class="icone" aria-hidden="true"><use href="#icone-mais" /></svg>
        Novo produto
    </a>
</div>

<form class="busca" method="get" asp-action="Index" role="search">
    <div class="campo-de-busca">
        <svg class="icone" aria-hidden="true"><use href="#icone-busca" /></svg>
        <input type="search" name="busca" value="@busca" class="form-control"
               placeholder="Buscar pelo nome" aria-label="Buscar produtos pelo nome" />
    </div>
    <button type="submit" class="btn btn-outline-secondary">Buscar</button>
</form>

@if (Model.Count == 0)
{
    <div class="vazio">
        <svg class="ilustracao" aria-hidden="true"><use href="@(string.IsNullOrWhiteSpace(busca) ? "#ilustracao-produtos" : "#ilustracao-busca")" /></svg>
        <p class="vazio-titulo">Nenhum produto encontrado.</p>
        @if (string.IsNullOrWhiteSpace(busca))
        {
            <p>Cadastre o que a loja vende para lançar nas vendas.</p>
            <a class="btn btn-primary" asp-action="Novo">
                <svg class="icone" aria-hidden="true"><use href="#icone-mais" /></svg>
                Cadastrar o primeiro produto
            </a>
        }
        else
        {
            <p>Confira o nome digitado, ou volte para a lista completa.</p>
            <a class="btn btn-outline-secondary" asp-action="Index">Limpar a busca</a>
        }
    </div>
}
else
{
    <p class="contagem" data-testid="contagem">
        @(string.IsNullOrWhiteSpace(busca)
            ? Formato.Quantidade(Model.Count, "produto", "produtos")
            : Formato.Quantidade(Model.Count, "produto encontrado", "produtos encontrados"))
    </p>

    <div class="cartao tabela-rolavel">
        <table class="tabela">
            <thead>
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col" class="valor coluna-opcional">Valor unitário</th>
                    <th scope="col"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var produto in Model)
                {
                    <tr>
                        <td>
                            <div class="destaque">@produto.Nome</div>
                            <div class="secundario numero apenas-no-celular">@Formato.Moeda(produto.ValorUnitario)</div>
                        </td>
                        <td class="valor coluna-opcional">@Formato.Moeda(produto.ValorUnitario)</td>
                        <td class="acoes">
                            <a class="acao" asp-action="Editar" asp-route-id="@produto.Id" aria-label="Editar @produto.Nome">
                                <svg class="icone" aria-hidden="true"><use href="#icone-editar" /></svg>
                                <span class="acao-texto">Editar</span>
                            </a>
                            <a class="acao perigo" asp-action="Excluir" asp-route-id="@produto.Id" aria-label="Excluir @produto.Nome"
                               data-confirmar data-confirmar-titulo="Excluir produto?" data-confirmar-nome="@produto.Nome"
                               data-confirmar-detalhe="@Formato.Moeda(produto.ValorUnitario)"
                               data-confirmar-aviso="A exclusão não pode ser desfeita. Produtos já vendidos não podem ser excluídos.">
                                <svg class="icone" aria-hidden="true"><use href="#icone-excluir" /></svg>
                                <span class="acao-texto">Excluir</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_ConfirmarExclusao" />
