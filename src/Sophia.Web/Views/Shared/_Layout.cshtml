@{
    var areaAtual = ViewContext.RouteData.Values["controller"] as string;
    string Ativo(string area) => area == areaAtual ? "nav-link active" : "nav-link";
    string? Atual(string area) => area == areaAtual ? "page" : null;
}
<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Sophia</title>
    <script>
        (() => {
            const lerTemaGuardado = () => {
                try {
                    return localStorage.getItem('sophia-tema');
                } catch {
                    return null;
                }
            };
            const preferencia = lerTemaGuardado() ?? 'automatico';
            const sistemaEscuro = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const escuro = preferencia === 'escuro' || (preferencia !== 'claro' && sistemaEscuro);
            document.documentElement.setAttribute('data-bs-theme', escuro ? 'dark' : 'light');
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" />
    <link rel="icon" type="image/png" sizes="64x64" href="~/img/simbolo.png" />
    <link rel="apple-touch-icon" href="~/img/simbolo-180.png" />
    <meta name="theme-color" content="#134169" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="_Icones" />
    <a class="pular-para-o-conteudo visually-hidden-focusable" href="#conteudo">Ir para o conteúdo</a>

    <header class="barra-superior">
        <nav class="navbar navbar-expand-md container" aria-label="Navegação principal">
            <a class="marca" href="~/">
                <img class="marca-logo marca-logo-claro" src="~/img/sophia.png" alt="Sophia" width="138" height="38" />
                <img class="marca-logo marca-logo-escuro" src="~/img/sophia-branco.png" alt="" width="138" height="38" aria-hidden="true" />
            </a>

            <div class="ferramentas-do-topo">
                <a class="btn btn-primary botao-nova-venda" asp-controller="Vendas" asp-action="Nova">
                    <svg class="icone" aria-hidden="true"><use href="#icone-mais" /></svg>
                    <span class="texto-nova-venda">Nova venda</span>
                </a>

                <div class="seletor-de-tema" role="radiogroup" aria-label="Tema" data-tema="grupo">
                    <button type="button" role="radio" class="seletor-de-tema-opcao" data-tema-opcao="claro" data-tema-nome="claro" aria-checked="false" aria-label="Claro" title="Claro">
                        <svg class="icone" aria-hidden="true"><use href="#icone-sol" /></svg>
                    </button>
                    <button type="button" role="radio" class="seletor-de-tema-opcao" data-tema-opcao="escuro" data-tema-nome="escuro" aria-checked="false" aria-label="Escuro" title="Escuro">
                        <svg class="icone" aria-hidden="true"><use href="#icone-lua" /></svg>
                    </button>
                    <button type="button" role="radio" class="seletor-de-tema-opcao" data-tema-opcao="automatico" data-tema-nome="automático" aria-checked="true" aria-label="Automático" title="Automático">
                        <svg class="icone" aria-hidden="true"><use href="#icone-automatico" /></svg>
                    </button>
                </div>

                <div class="dropdown menu-do-tema-compacto">
                    <button type="button" class="btn botao-do-tema" data-bs-toggle="dropdown" aria-expanded="false"
                            aria-label="Escolher o tema (atual: automático)" data-rotulo="Escolher o tema (atual: {tema})" data-tema="botao">
                        <svg class="icone" aria-hidden="true"><use href="#icone-automatico" data-tema="icone" /></svg>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end menu-do-tema">
                        <li>
                            <button type="button" class="dropdown-item" data-tema-opcao="claro" data-tema-nome="claro" aria-pressed="false">
                                <svg class="icone" aria-hidden="true"><use href="#icone-sol" /></svg>
                                Claro
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item" data-tema-opcao="escuro" data-tema-nome="escuro" aria-pressed="false">
                                <svg class="icone" aria-hidden="true"><use href="#icone-lua" /></svg>
                                Escuro
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item" data-tema-opcao="automatico" data-tema-nome="automático" aria-pressed="true">
                                <svg class="icone" aria-hidden="true"><use href="#icone-automatico" /></svg>
                                Automático
                            </button>
                        </li>
                    </ul>
                </div>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-controls="menu" aria-expanded="false" aria-label="Abrir o menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="@Ativo("Painel")" aria-current="@Atual("Painel")" href="~/">
                            <svg class="icone" aria-hidden="true"><use href="#icone-painel" /></svg>
                            Painel
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="@Ativo("Produtos")" aria-current="@Atual("Produtos")" asp-controller="Produtos" asp-action="Index">
                            <svg class="icone" aria-hidden="true"><use href="#icone-produtos" /></svg>
                            Produto
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="@Ativo("Clientes")" aria-current="@Atual("Clientes")" asp-controller="Clientes" asp-action="Index">
                            <svg class="icone" aria-hidden="true"><use href="#icone-clientes" /></svg>
                            Cliente
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="@Ativo("Vendas")" aria-current="@Atual("Vendas")" asp-controller="Vendas" asp-action="Index">
                            <svg class="icone" aria-hidden="true"><use href="#icone-vendas" /></svg>
                            Venda
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="container conteudo" id="conteudo" tabindex="-1">
        <partial name="_Avisos" />
        @RenderBody()
    </main>

    <footer class="rodape container">Sophia, a força de venda da sua loja.</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="~/js/confirmar.js" asp-append-version="true"></script>
    <script type="module" src="~/js/lista.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
