@{
    var areaAtual = ViewContext.RouteData.Values["controller"] as string;
    string Ativo(string area) => area == areaAtual ? "nav-link active" : "nav-link";
    string? Atual(string area) => area == areaAtual ? "page" : null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Sophia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="barra-superior">
        <nav class="navbar navbar-expand-md container" aria-label="Navegação principal">
            <a class="marca" asp-controller="Vendas" asp-action="Index">
                <span class="marca-simbolo" aria-hidden="true">S</span>
                <span>Sophia</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                    aria-controls="menu" aria-expanded="false" aria-label="Abrir o menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="@Ativo("Vendas")" aria-current="@Atual("Vendas")" asp-controller="Vendas" asp-action="Index">Vendas</a>
                    </li>
                    <li class="nav-item">
                        <a class="@Ativo("Clientes")" aria-current="@Atual("Clientes")" asp-controller="Clientes" asp-action="Index">Clientes</a>
                    </li>
                    <li class="nav-item">
                        <a class="@Ativo("Produtos")" aria-current="@Atual("Produtos")" asp-controller="Produtos" asp-action="Index">Produtos</a>
                    </li>
                </ul>
                <a class="btn btn-primary" asp-controller="Vendas" asp-action="Nova">Nova venda</a>
            </div>
        </nav>
    </header>

    <main class="container conteudo">
        <partial name="_Avisos" />
        @RenderBody()
    </main>

    <footer class="rodape container">Sophia · controle de vendas</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
