@{
    var areaAtual = ViewContext.RouteData.Values["controller"] as string;
    string Ativo(string area) => area == areaAtual ? "nav-link active" : "nav-link";
    string? Atual(string area) => area == areaAtual ? "page" : null;
}
<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – @T["geral.marca"]</title>
    <script src="~/js/tema-inicial.js" asp-append-version="true"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" />
    <link rel="icon" type="image/png" sizes="64x64" href="~/img/simbolo.png" />
    <link rel="apple-touch-icon" href="~/img/simbolo-180.png" />
    <meta name="theme-color" content="#134169" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/componentes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsivo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/painel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pessoas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cupom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/listas.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="modulepreload" href="~/js/comum/mascaras.js" />
    <link rel="modulepreload" href="~/js/comum/imprimir.js" />
    <link rel="modulepreload" href="~/js/comum/tema.js" />
    <link rel="modulepreload" href="~/js/comum/avisos.js" />
    <link rel="modulepreload" href="~/js/comum/foco-no-erro.js" />
    <link rel="modulepreload" href="~/js/comum/trava-de-envio.js" />
</head>
<body>
    <partial name="_Icones" />
    <a class="pular-para-o-conteudo visually-hidden-focusable" href="#conteudo">@T["geral.ir-para-o-conteudo"]</a>

    <header class="barra-superior">
        <nav class="navbar navbar-expand-md container" aria-label="@T["geral.navegacao-principal"]">
            <a class="marca" href="~/">
                <img class="marca-logo marca-logo-claro" src="~/img/sophia.png" alt="@T["geral.marca"]" width="138" height="38" />
                <img class="marca-logo marca-logo-escuro" src="~/img/sophia-branco.png" alt="" width="138" height="38" aria-hidden="true" />
            </a>

            <div class="ferramentas-do-topo">
                <a class="btn btn-primary botao-nova-venda" asp-controller="Vendas" asp-action="Nova">
                    <svg class="icone" aria-hidden="true"><use href="#icone-mais" /></svg>
                    <span class="texto-nova-venda">@T["vendas.nova-venda"]</span>
                </a>

                <div class="seletor-de-tema" role="radiogroup" aria-label="@T["tema.grupo"]" data-tema="grupo">
                    <button type="button" role="radio" class="seletor-de-tema-opcao" data-tema-opcao="claro" data-tema-nome="@T["tema.nome-claro"]" aria-checked="false" aria-label="@T["tema.claro"]" title="@T["tema.claro"]">
                        <svg class="icone" aria-hidden="true"><use href="#icone-sol" /></svg>
                    </button>
                    <button type="button" role="radio" class="seletor-de-tema-opcao" data-tema-opcao="escuro" data-tema-nome="@T["tema.nome-escuro"]" aria-checked="false" aria-label="@T["tema.escuro"]" title="@T["tema.escuro"]">
                        <svg class="icone" aria-hidden="true"><use href="#icone-lua" /></svg>
                    </button>
                    <button type="button" role="radio" class="seletor-de-tema-opcao" data-tema-opcao="automatico" data-tema-nome="@T["tema.nome-automatico"]" aria-checked="true" aria-label="@T["tema.automatico"]" title="@T["tema.automatico"]">
                        <svg class="icone" aria-hidden="true"><use href="#icone-automatico" /></svg>
                    </button>
                </div>

                <div class="dropdown menu-do-tema-compacto">
                    <button type="button" class="btn botao-do-tema" data-bs-toggle="dropdown" aria-expanded="false"
                            aria-label="@T["tema.escolher"].Value.Replace("{tema}", T["tema.nome-automatico"].Value, StringComparison.Ordinal)" data-rotulo="@T["tema.escolher"]" data-tema="botao">
                        <svg class="icone" aria-hidden="true"><use href="#icone-automatico" data-tema="icone" /></svg>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end menu-do-tema">
                        <li>
                            <button type="button" class="dropdown-item" data-tema-opcao="claro" data-tema-nome="@T["tema.nome-claro"]" aria-pressed="false">
                                <svg class="icone" aria-hidden="true"><use href="#icone-sol" /></svg>
                                @T["tema.claro"]
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item" data-tema-opcao="escuro" data-tema-nome="@T["tema.nome-escuro"]" aria-pressed="false">
                                <svg class="icone" aria-hidden="true"><use href="#icone-lua" /></svg>
                                @T["tema.escuro"]
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item" data-tema-opcao="automatico" data-tema-nome="@T["tema.nome-automatico"]" aria-pressed="true">
                                <svg class="icone" aria-hidden="true"><use href="#icone-automatico" /></svg>
                                @T["tema.automatico"]
                            </button>
                        </li>
                    </ul>
                </div>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-controls="menu" aria-expanded="false" aria-label="@T["geral.abrir-o-menu"]">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="@Ativo("Painel")" aria-current="@Atual("Painel")" href="~/">
                            <svg class="icone" aria-hidden="true"><use href="#icone-painel" /></svg>
                            @T["menu.painel"]
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="@Ativo("Produtos")" aria-current="@Atual("Produtos")" asp-controller="Produtos" asp-action="Index">
                            <svg class="icone" aria-hidden="true"><use href="#icone-produtos" /></svg>
                            @T["menu.produto"]
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="@Ativo("Clientes")" aria-current="@Atual("Clientes")" asp-controller="Clientes" asp-action="Index">
                            <svg class="icone" aria-hidden="true"><use href="#icone-clientes" /></svg>
                            @T["menu.cliente"]
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="@Ativo("Vendas")" aria-current="@Atual("Vendas")" asp-controller="Vendas" asp-action="Index">
                            <svg class="icone" aria-hidden="true"><use href="#icone-vendas" /></svg>
                            @T["menu.venda"]
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="container conteudo" id="conteudo" tabindex="-1">
        <partial name="_Avisos" />
        @RenderBody()
    </main>

    <footer class="rodape container">@T["geral.rodape"]</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="~/js/confirmar.js" asp-append-version="true"></script>
    <script type="module" src="~/js/lista.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
