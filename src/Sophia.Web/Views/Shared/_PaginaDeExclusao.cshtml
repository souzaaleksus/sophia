@model PaginaDeExclusao

<div class="cabecalho-da-pagina">
    <div>
        <h1>@Model.Titulo</h1>
        <p class="subtitulo">@Model.Aviso</p>
    </div>
</div>

<form class="cartao formulario" method="post" asp-action="Excluir" asp-route-id="@Model.Id" data-envio data-texto-enviando="@T["exclusao.excluindo"]">
    <dl class="resumo-de-registro">
        <dt>@T["campo.nome"]</dt>
        <dd>@Model.Nome</dd>
        <dt>@Model.RotuloDoDetalhe</dt>
        <dd>@Model.Detalhe</dd>
    </dl>

    <div class="rodape-do-formulario">
        <a class="btn btn-outline-secondary" asp-action="Index">@T["formulario.cancelar"]</a>
        <button type="submit" class="btn btn-danger">
            <svg class="icone" aria-hidden="true"><use href="#icone-excluir" /></svg>
            @T["acao.excluir"]
        </button>
    </div>
</form>
