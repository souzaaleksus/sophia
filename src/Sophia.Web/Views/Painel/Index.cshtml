@model Sophia.Application.Painel.PainelDto
@{
    ViewData["Title"] = "Painel";
    var nomeDoMes = Formato.NomeDoMes(Model.Hoje);
}

<div class="cabecalho-da-pagina">
    <div>
        <h1>Painel</h1>
        <p class="subtitulo">@Formato.DataPorExtenso(Model.Hoje)</p>
    </div>
</div>

<section class="indicadores" aria-label="Resumo das vendas">
    <div class="visor" data-testid="vendido-hoje">
        <span class="visor-rotulo">Vendido hoje</span>
        <span class="visor-valor">@Formato.QuebrarNoMilhar(Formato.Moeda(Model.Dia.Total))</span>
        <span class="visor-detalhe">@Formato.Quantidade(Model.Dia.QuantidadeDeVendas, "venda", "vendas")</span>
    </div>

    <div class="cartao indicador" data-testid="vendido-no-mes">
        <span class="indicador-rotulo">Vendido em @nomeDoMes</span>
        <span class="indicador-valor">@Formato.QuebrarNoMilhar(Formato.Moeda(Model.Mes.Total))</span>
        <span class="indicador-detalhe">@Formato.Quantidade(Model.Mes.QuantidadeDeVendas, "venda", "vendas")</span>
    </div>

    <div class="cartao indicador" data-testid="ticket-medio">
        <span class="indicador-rotulo">Ticket médio em @nomeDoMes</span>
        <span class="indicador-valor">@Formato.QuebrarNoMilhar(Formato.Moeda(Model.Mes.TicketMedio))</span>
        <span class="indicador-detalhe">por venda</span>
    </div>
</section>

@{
    var maiorDia = Model.UltimosDias.Count == 0 ? 0m : Model.UltimosDias.Max(dia => dia.Total);
    var maiorQuantidade = Model.MaisVendidos.Count == 0 ? 0 : Model.MaisVendidos.Max(produto => produto.Quantidade);
    var totalDaSemana = Model.UltimosDias.Sum(dia => dia.Total);
}

<div class="graficos">
    <section class="cartao grafico" aria-labelledby="titulo-ultimos-dias" data-testid="grafico-ultimos-dias">
        <div class="cabecalho-do-grafico">
            <h2 id="titulo-ultimos-dias">Últimos @Model.UltimosDias.Count dias</h2>
            <p class="grafico-resumo numero">@Formato.Moeda(totalDaSemana)</p>
        </div>
        <ol class="barras" aria-hidden="true">
            @foreach (var dia in Model.UltimosDias)
            {
                var ehHoje = dia.Dia == Model.Hoje;
                <li class="barra-do-dia@(ehHoje ? " hoje" : string.Empty)" data-dia="@Formato.DataParaCampo(dia.Dia)" aria-current="@(ehHoje ? "date" : null)"
                    title="@Formato.DiaDaSemanaCurto(dia.Dia) @Formato.DiaEMes(dia.Dia): @Formato.Moeda(dia.Total), @Formato.Quantidade(dia.QuantidadeDeVendas, "venda", "vendas")">
                    <span class="barra-valor numero">@Formato.Moeda(dia.Total)</span>
                    <span class="barra-trilho"><svg class="barra" focusable="false">@if (dia.Total > 0)
                    {
                        <rect class="barra-preenchida" width="100%" height="100%" y="@Formato.PercentualRestante(dia.Total, maiorDia)" rx="4" /><rect class="barra-preenchida" width="100%" height="6" y="100%" transform="translate(0 -6)" rx="2" />
                    }</svg></span>
                    <span class="barra-rotulo">@(ehHoje ? "hoje" : Formato.DiaDaSemanaCurto(dia.Dia))</span>
                </li>
            }
        </ol>
        <div class="visually-hidden">
            <table>
                <caption>Total vendido em cada um dos últimos @Model.UltimosDias.Count dias</caption>
                <thead>
                    <tr><th scope="col">Dia</th><th scope="col">Total</th><th scope="col">Vendas</th></tr>
                </thead>
                <tbody>
                    @foreach (var dia in Model.UltimosDias)
                    {
                        <tr>
                            <th scope="row">@Formato.DiaDaSemanaCurto(dia.Dia) @Formato.Data(dia.Dia)</th>
                            <td>@Formato.Moeda(dia.Total)</td>
                            <td>@dia.QuantidadeDeVendas</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="cartao grafico" aria-labelledby="titulo-mais-vendidos">
        <div class="cabecalho-do-grafico">
            <h2 id="titulo-mais-vendidos">Mais vendidos em @nomeDoMes</h2>
            <p class="grafico-resumo">por unidades</p>
        </div>
        @if (Model.MaisVendidos.Count == 0)
        {
            <p class="grafico-vazio">Nenhum produto vendido neste mês ainda.</p>
        }
        else
        {
            <ol class="ranking" data-testid="mais-vendidos">
                @foreach (var produto in Model.MaisVendidos)
                {
                    <li class="ranking-item" data-testid="mais-vendido">
                        <div class="ranking-linha">
                            <span class="ranking-nome">@produto.Nome</span>
                            <span class="ranking-quantidade numero">@Formato.Quantidade(produto.Quantidade, "unidade", "unidades")</span>
                        </div>
                        <svg class="ranking-trilho" aria-hidden="true" focusable="false"><rect class="ranking-barra" width="@Formato.Percentual(produto.Quantidade, maiorQuantidade)" height="100%" rx="4" /></svg>
                        <span class="secundario numero">@Formato.Moeda(produto.Total)</span>
                    </li>
                }
            </ol>
        }
    </section>
</div>

<section class="cartao ultimas-vendas" aria-labelledby="titulo-ultimas-vendas">
    <div class="cabecalho-do-cartao">
        <h2 id="titulo-ultimas-vendas">Últimas vendas</h2>
        <a asp-controller="Vendas" asp-action="Index">Ver todas</a>
    </div>

    @if (Model.UltimasVendas.Count == 0)
    {
        <div class="vazio vazio-embutido">
            <svg class="ilustracao" aria-hidden="true"><use href="#ilustracao-vendas" /></svg>
            <p class="vazio-titulo">Nenhuma venda registrada ainda.</p>
            <a class="btn btn-primary" asp-controller="Vendas" asp-action="Nova">
                <svg class="icone" aria-hidden="true"><use href="#icone-mais" /></svg>
                Registrar a primeira venda
            </a>
        </div>
    }
    else
    {
        <div class="tabela-rolavel">
            <table class="tabela">
                <thead>
                    <tr>
                        <th scope="col" class="coluna-opcional">Nº</th>
                        <th scope="col" class="coluna-opcional">Data</th>
                        <th scope="col">Cliente</th>
                        <th scope="col" class="valor">Total</th>
                        <th scope="col"><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var venda in Model.UltimasVendas)
                    {
                        <tr>
                            <td class="numero coluna-opcional">@venda.Id</td>
                            <td class="numero coluna-opcional">@Formato.Data(venda.Data)</td>
                            <td>
                                <div class="destaque">@venda.ClienteNome</div>
                                <div class="secundario numero">@venda.ClienteCpf</div>
                                <div class="secundario numero apenas-no-celular">nº @venda.Id, @Formato.Data(venda.Data)</div>
                            </td>
                            <td class="valor destaque">@Formato.QuebrarNoMilhar(Formato.Moeda(venda.Total))</td>
                            <td class="acoes">
                                <a class="acao" asp-controller="Vendas" asp-action="Detalhe" asp-route-id="@venda.Id" aria-label="Ver a venda @venda.Id">Ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
